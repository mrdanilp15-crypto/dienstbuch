# Geheimer Schlüssel für die Verschlüsselung der Login-Cookies
# (Hier kannst du einen beliebigen, langen Text eintragen)
SECRET_KEY=digitales-dienstbuch-global-sovereign-key-112

# Das Datenbank-Passwort, das FastAPI für die Verbindung nutzt
DB_PASSWORD=feuerwehr

# --- Für deinen MySQL / MariaDB Docker-Container ---
# Diese Variablen sorgen dafür, dass die Datenbank beim ersten Start 
# exakt so erstellt wird, wie das Backend es erwartet:
MYSQL_DATABASE=attendance_system
MYSQL_USER=app_user
MYSQL_PASSWORD=feuerwehr
MYSQL_ROOT_PASSWORD=SicheresRootKennwort112!
