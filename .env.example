# Vorlage fuer die Einstellungen des Dienstbuchs.
# In Portainer: Stack > "Environment variables" > "Advanced mode" und diese Zeilen mit
# EIGENEN Werten einfuegen. Mit docker compose: Datei nach ".env" kopieren und ausfuellen.
# Die echte ".env" NIEMALS ins Git-Repo hochladen (steht in .gitignore).

# --- Datenbank ---
# Zwei lange, zufaellige Passwoerter (je mind. 20 Zeichen), z. B. erzeugt mit:
#   openssl rand -base64 24
ROOT_PASS=
DB_PASS=
DB_USER=app_user
DB_NAME=attendance_system

# --- Dienstbuch ---
TOWN_NAME=Feuerwehr Musterstadt
# Zufaelliger Schluessel zum Signieren der Anmeldungen (mind. 32 Zeichen), z. B.:
#   openssl rand -hex 32
# Wird er geaendert, werden alle angemeldeten Nutzer abgemeldet und ein gespeichertes
# SMTP-Passwort muss in der Verwaltung neu eingegeben werden.
SECRET_KEY=

# Ordner auf dem Server, in dem die Datenbank-Dateien liegen sollen
STAPEL_PFAD=/srv/dienstbuch

# Optional: woher Update-Hinweise geladen werden (Standard: dieses GitHub-Repo)
# UPDATE_BASE_URL=
